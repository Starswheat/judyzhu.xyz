{
  "name": "judy-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.mjs --host 127.0.0.1 --port 4173",
    "check": "tsc --project config/tsconfig.json --noEmit",
    "build": "npm run check && vite build --config config/vite.config.mjs && node scripts/prepare-portfolio.mjs",
    "preview": "vite preview --config config/vite.config.mjs --host 127.0.0.1 --port 4173",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.2"
  }
}
